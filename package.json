{
  "name": "badgesmith",
  "version": "0.1.0",
  "description": "Renders several icon/value pairs as a single SVG badge",
  "keywords": [
    "badge",
    "svg",
    "octicons",
    "simple-icons",
    "shields",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/bvandrc/badgesmith",
  "bugs": {
    "url": "https://github.com/bvandrc/badgesmith/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvandrc/badgesmith.git"
  },
  "author": "Blake Vandercar",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "build": "tsdown",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "gen:all": "pnpm gen:icons && pnpm gen:widths && pnpm gen:svg && pnpm gen:pages",
    "gen:icons": "node --experimental-strip-types scripts/generate-icons.ts",
    "gen:widths": "node --experimental-strip-types scripts/generate-text-widths.ts",
    "gen:svg": "node --experimental-strip-types scripts/generate-svg.ts",
    "gen:pages": "tsx --tsconfig tsconfig.test.json scripts/generate-pages.ts",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "biome check . && pnpm ts:check",
    "format": "biome check . --fix",
    "ts:check": "tsc && tsc --project tsconfig.test.json",
    "__c2": "====================[ Unit Testing ]=============================",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "e2e": "node --experimental-strip-types scripts/e2e.ts"
  },
  "dependencies": {
    "es-toolkit": "^1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6",
    "@cloudflare/workers-types": "^4",
    "@primer/octicons": "^19",
    "@types/node": "^26",
    "anafanafo": "^2",
    "fontkit": "^2",
    "preact": "^11",
    "preact-render-to-string": "^6",
    "simple-icons": "^16",
    "tsdown": "^0.23",
    "tsx": "^4",
    "type-fest": "^5",
    "typescript": "^7",
    "wrangler": "^4",
    "zod": "^4"
  },
  "engines": {
    "node": ">=20"
  }
}
